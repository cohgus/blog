---
interface Props {
  current?: string;
}

const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}`, label: 'Home', id: 'home' },
  { href: `${base}sobre/`, label: 'Sobre', id: 'sobre' },
  { href: `${base}livro/`, label: 'Livro', id: 'livro' },
  { href: `${base}projetos/`, label: 'Projetos', id: 'projetos' },
];
---

<header style="
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  background: rgba(5, 10, 16, 0.85);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  border-bottom: 1px solid var(--border);
">
  <nav style="
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  ">
    <a href={`${base}`} style="
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      letter-spacing: 0.05em;
    ">
      cohgus
    </a>

    <div style="display: flex; gap: 1.5rem; align-items: center;">
      {links.map(link => (
        <a
          href={link.href}
          style={`
            font-family: var(--font-sans);
            font-size: 0.8rem;
            text-decoration: none;
            color: ${current === link.id ? 'var(--text-primary)' : 'var(--text-muted)'};
            transition: color 0.2s ease;
            ${current === link.id ? 'font-weight: 500;' : ''}
          `}
          onmouseover="this.style.color='var(--text-primary)'"
          onmouseout={current === link.id ? '' : "this.style.color='var(--text-muted)'"}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
