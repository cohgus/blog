---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Home" current="home">

  <!-- Hero -->
  <section style="
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 6rem 1.5rem 3rem;
  ">
    <h1 class="text-gradient reveal stagger-1">Gustavo Cohgus</h1>

    <p class="reveal stagger-2" style="
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-top: 0.75rem;
    ">
      Tecnologia, inteligencia artificial e automacao
    </p>

    <p class="reveal stagger-3" style="
      font-family: var(--font-sans);
      color: var(--text-secondary);
      font-size: 0.95rem;
      max-width: 45ch;
      margin-top: 1.5rem;
      line-height: 1.7;
    ">
      Fundador da aiBotize, desenvolvedor de plataformas de atendimento automatizado via IA. Escritor e estudante de Analise e Desenvolvimento de Sistemas.
    </p>

    <div class="reveal stagger-4" style="
      display: flex;
      gap: 1.5rem;
      margin-top: 2rem;
    ">
      <a href={`${base}sobre/`} class="link-underline" style="
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
        text-decoration: none;
      ">
        Sobre mim &rarr;
      </a>
      <a href={`${base}projetos/`} class="link-underline" style="
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
        text-decoration: none;
      ">
        Projetos &rarr;
      </a>
    </div>
  </section>

  <!-- Divider -->
  <div class="divider" style="
    max-width: var(--content-max-width);
    margin: 0 auto;
  "></div>

  <!-- O que faco -->
  <section style="
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
  ">
    <h2 class="reveal" style="
      font-size: 1.25rem;
      margin-bottom: 2rem;
    ">O que faco</h2>

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 1.25rem;
    ">
      <!-- Card 1 -->
      <div class="card-hover reveal stagger-1" style="
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem;
      ">
        <span class="badge" style="margin-bottom: 1rem;">IA</span>
        <h3 style="
          font-family: var(--font-display);
          font-size: 1rem;
          margin-top: 0.75rem;
          color: var(--text-primary);
        ">Plataformas de IA</h3>
        <p style="
          font-family: var(--font-sans);
          font-size: 0.85rem;
          color: var(--text-secondary);
          margin-top: 0.5rem;
          line-height: 1.65;
        ">
          Desenvolvimento de sistemas de atendimento automatizado via WhatsApp, com processamento de linguagem natural e integracao multicanal.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="card-hover reveal stagger-2" style="
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem;
      ">
        <span class="badge" style="margin-bottom: 1rem;">Dados</span>
        <h3 style="
          font-family: var(--font-display);
          font-size: 1rem;
          margin-top: 0.75rem;
          color: var(--text-primary);
        ">Dados e BI</h3>
        <p style="
          font-family: var(--font-sans);
          font-size: 0.85rem;
          color: var(--text-secondary);
          margin-top: 0.5rem;
          line-height: 1.65;
        ">
          Pipelines de dados, dashboards executivos e inteligencia operacional para tomada de decisao baseada em dados reais.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="card-hover reveal stagger-3" style="
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem;
      ">
        <span class="badge" style="margin-bottom: 1rem;">Automacao</span>
        <h3 style="
          font-family: var(--font-display);
          font-size: 1rem;
          margin-top: 0.75rem;
          color: var(--text-primary);
        ">Automacao</h3>
        <p style="
          font-family: var(--font-sans);
          font-size: 0.85rem;
          color: var(--text-secondary);
          margin-top: 0.5rem;
          line-height: 1.65;
        ">
          Workflows de automacao com N8N, APIs REST, integracoes entre ERPs, CRMs e plataformas de comunicacao.
        </p>
      </div>
    </div>
  </section>

  <!-- Formacao -->
  <section style="
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
  ">
    <h2 class="reveal" style="
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
    ">Formacao</h2>

    <ul class="reveal stagger-1" style="
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    ">
      <li style="
        font-family: var(--font-sans);
        font-size: 0.85rem;
        color: var(--text-secondary);
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      ">
        <span style="
          width: 6px;
          height: 6px;
          min-width: 6px;
          border-radius: 50%;
          background: var(--accent);
          display: inline-block;
          position: relative;
          top: -1px;
        "></span>
        <span>
          <strong style="color: var(--text-primary); font-weight: 500;">Analise e Desenvolvimento de Sistemas</strong>
          <span style="color: var(--text-muted); margin-left: 0.5rem;">— em curso</span>
        </span>
      </li>
      <li style="
        font-family: var(--font-sans);
        font-size: 0.85rem;
        color: var(--text-secondary);
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      ">
        <span style="
          width: 6px;
          height: 6px;
          min-width: 6px;
          border-radius: 50%;
          background: var(--accent);
          display: inline-block;
          position: relative;
          top: -1px;
        "></span>
        <span>
          <strong style="color: var(--text-primary); font-weight: 500;">Tecnico em Eletromecanica</strong>
        </span>
      </li>
      <li style="
        font-family: var(--font-sans);
        font-size: 0.85rem;
        color: var(--text-secondary);
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      ">
        <span style="
          width: 6px;
          height: 6px;
          min-width: 6px;
          border-radius: 50%;
          background: var(--accent);
          display: inline-block;
          position: relative;
          top: -1px;
        "></span>
        <span>
          <strong style="color: var(--text-primary); font-weight: 500;">Estudos em Engenharia, Musicoterapia e Psicanalise</strong>
        </span>
      </li>
    </ul>
  </section>

  <!-- Contato -->
  <section style="
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  ">
    <h2 class="reveal" style="
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
    ">Contato</h2>

    <div class="reveal stagger-1" style="
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.8rem;
    ">
      <a href="mailto:cohgus@gmail.com" class="link-underline" style="
        color: var(--accent);
        text-decoration: none;
      ">cohgus@gmail.com</a>

      <span style="color: var(--border);">|</span>

      <a href="https://wa.me/5541984404661" target="_blank" rel="noopener noreferrer" class="link-underline" style="
        color: var(--accent);
        text-decoration: none;
      ">+55 41 98440-4661</a>

      <span style="color: var(--border);">|</span>

      <span style="color: var(--text-muted);">Apucarana, PR</span>
    </div>
  </section>

</Base>
